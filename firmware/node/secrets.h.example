#pragma once

// COPY this file to secrets.h and fill it locally.
// Never upload/share secrets.h. The credentials pasted in the chat must be rotated.

#define TB_HOST "thingsboard.cloud"
#define TB_TOKEN_CENTER "xxxxxxxx"
#define TB_TOKEN_NODE_A "xxxxxxxx"
#define TB_TOKEN_NODE_B "xxxxxxxx"
#define TB_TOKEN_NODE_C "xxxxxxxx"

#define TG_BOT_TOKEN "12345:xxxxxxxxx"
#define TG_CHAT_ID "1234xxxxx"

// WiFiManager configuration portal password; use at least 8 characters.
#define WIFI_AP_PASSWORD "12345678"

// Use exactly the same RUN_ID and limits on all four ESP8266 boards for each run.
// Examples: "P0_MQTT_R1", "P0_HTTP_R1", "P1_MQTT_R1".
#define EXPERIMENT_RUN_ID "P0_MQTT_R1"

// Number of initial cloud messages used only to warm up HTTP/MQTT connections; exclude from analysis.
#define WARMUP_CLOUD_MESSAGES 3

// 0 = continuous publishing; e.g. 100 = stop cloud publishing after 100 attempts.
// Local MQTT between nodes and the center continues regardless.
#define MAX_CLOUD_MESSAGES 100

// Set to 0 during controlled QoS captures to keep Telegram HTTPS traffic out of the run.
// Set to 1 for separate functional-notification tests.
#define ENABLE_TELEGRAM_DURING_QOS_TEST 0
